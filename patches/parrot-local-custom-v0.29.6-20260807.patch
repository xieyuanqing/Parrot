+def normalize_cache_ttl(value) -> str:
+    raw = str(value or "").strip().lower()
+    if raw in {"passthrough", "pass", "raw", "none", "off", "disabled", "disable"}:
+        return PASSTHROUGH_CACHE_TTL
+    if raw in {"1h", "hour", "1hour", "60m", "3600", "3600s"}:
