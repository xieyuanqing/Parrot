+def _collect_cache_controls(obj):
+    found = []
+    if isinstance(obj, dict):
+        cc = obj.get("cache_control")
+        if isinstance(cc, dict):
+            found.append(cc)
+        for value in obj.values():
+            found.extend(_collect_cache_controls(value))
+    elif isinstance(obj, list):
+        for value in obj:
+            found.extend(_collect_cache_controls(value))
+    return found
